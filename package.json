{
  "name": "monster-hunter-ultimate-quiz",
  "version": "1.0.0",
  "description": "Application Windows de quiz premium inspirée de Monster Hunter",
  "main": "dist/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "package": "electron-builder",
    "start": "electron .",
    "validate-questions": "ts-node scripts/validateQuestions.ts"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "framer-motion": "^10.16.4",
    "howler": "^2.2.4",
    "i18next": "^23.7.0",
    "react-i18next": "^13.5.0",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@types/react": "^18.2.42",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0",
    "typescript": "^5.3.2",
    "vite": "^5.0.6",
    "ts-node": "^10.9.1"
  },
  "build": {
    "appId": "com.mh.ultimatequiz",
    "productName": "Monster Hunter Ultimate Quiz",
    "files": ["dist/**/*", "public/**/*"],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": ["nsis", "portable"],
      "icon": "public/images/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "types": ["vite/client"],
  "include": ["src/**/*", "public/**/*", "scripts/**/*"]
}
